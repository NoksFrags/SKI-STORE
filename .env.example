# Application
APP_NAME="Ski Store"
APP_ENV=local
APP_DEBUG=true
# Leave empty so the base path is detected automatically (works in a subfolder such as /SKI-STORE).
APP_URL=
TIMEZONE=Europe/Sarajevo

# Database (XAMPP defaults: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skistore
DB_USER=root
DB_PASS=

# Store settings
CURRENCY=KM
CURRENCY_DECIMALS=2
SHIPPING_FLAT=9.90
FREE_SHIPPING_FROM=200.00
