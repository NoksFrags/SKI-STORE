Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Files inside /public are served directly (assets, uploads).
    RewriteRule ^public/ - [L]

    # Everything else is handled by the front controller.
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>

# Never expose dotfiles such as .env
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
